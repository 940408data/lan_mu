{
  "work": "大学章句",
  "pages": [
    {
      "n": 8,
      "engine": "初校(qwen3.7-plus)",
      "conf": 0.9562499999999998,
      "cols": [
        {
          "col": 1,
          "text": "后與後同後放此○止者所當止之",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 2,
          "text": "地即至善之所在也知之則志有定",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 3,
          "text": "向靜謂心不妄動安謂所處而安慮",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 4,
          "text": "謂處事精詳得謂得其所止",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 5,
          "text": "物有本末事有終始知所先後則近道",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 6,
          "text": "矣",
          "type": "j",
          "conf": 0.99
        },
        {
          "col": 7,
          "text": "明德為本新民為末知止為始能得",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 8,
          "text": "為終本始所先末終所後此結上文",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 9,
          "text": "兩節之意",
          "type": "j",
          "conf": 0.98
        },
        {
          "col": 10,
          "text": "古之欲明明德於天下者先治其國欲",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 11,
          "text": "治其國者先齊其家欲齊其家者先脩",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 12,
          "text": "其身欲脩其身者先正其心欲正其心",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 13,
          "text": "者先誠其意欲誠其意者先致其知致",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 14,
          "text": "知在格物",
          "type": "j",
          "conf": 0.98
        },
        {
          "col": 15,
          "text": "治平聲後放此○明明德於天下者",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 16,
          "text": "使天下之人皆有以明其明德也心",
          "type": "j",
          "conf": 0.95
        }
      ]
    },
    {
      "n": 9,
      "engine": "初校(qwen3.7-plus)",
      "conf": 0.9499999999999997,
      "cols": [
        {
          "col": 1,
          "text": "者身之所主也誠實也意者心之所",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 2,
          "text": "發也實其心之所發欲其一於善而",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 3,
          "text": "無自欺也致推極也知猶識也推極",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 4,
          "text": "吾之知識欲其所知無不盡也格至",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 5,
          "text": "也物猶事也窮至事物之理欲其極",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 6,
          "text": "處無不到也此八者大學之條目也",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 7,
          "text": "物格而后知至知至而后意誠意誠而",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 8,
          "text": "后心正心正而后身脩身而后家齊",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 9,
          "text": "家齊而后國治國治而后天下平",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 10,
          "text": "治去聲後放此○物格者物理之極",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 11,
          "text": "處無不到也知至者吾心之所知無",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 12,
          "text": "不盡也知旣盡則意可得而實矣意",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 13,
          "text": "旣實則心可得而正矣脩身以上明",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 14,
          "text": "明德之事也齊家以下新民之事也",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 15,
          "text": "物格知至則知所止矣意誠以下則",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 16,
          "text": "皆得所止之序也",
          "type": "j",
          "conf": 0.95
        }
      ]
    },
    {
      "n": 10,
      "engine": "初校(qwen3.7-plus)",
      "conf": 0.9466666666666664,
      "cols": [
        {
          "col": 1,
          "text": "自天子以至於庶人壹是皆以脩身爲",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 2,
          "text": "本",
          "type": "j",
          "conf": 0.99
        },
        {
          "col": 3,
          "text": "壹是一切也正心以上皆所以脩身",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 4,
          "text": "也齊家以下則舉此而錯之耳",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 5,
          "text": "其本亂而末治者否矣其所厚者薄而",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 6,
          "text": "其所薄者厚未之有也",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 7,
          "text": "本謂身也所厚謂家也此兩節結上",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 8,
          "text": "文兩節之意",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 9,
          "text": "右經一章蓋孔子之言而曾子述",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 10,
          "text": "凡二百五字",
          "type": "z",
          "conf": 0.9
        },
        {
          "col": 11,
          "text": "其傳十章則曾子之意",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 12,
          "text": "而門人記之也舊本頗有錯簡今",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 13,
          "text": "因程子所定而更考經文别爲序",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 14,
          "text": "凡千五百四十六字",
          "type": "z",
          "conf": 0.9
        },
        {
          "col": 15,
          "text": "次如左",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 16,
          "text": "凡傳文雜引經傳若無統紀然",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 17,
          "text": "文理接續血脉貫通深淺始終",
          "type": "j",
          "conf": 0.95
        },
        {
          "col": 18,
          "text": "至爲精密熟讀詳味久當見之",
          "type": "j",
          "conf": 0.95
        }
      ]
    }
  ]
}