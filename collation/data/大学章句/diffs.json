[
  {
    "id": "v1",
    "type": "异体",
    "shanben": "旣",
    "xiandai": "既",
    "pos": "2:0",
    "note": "善本「旣」现代本「既」异体同字",
    "seg": "蓋自天降生民，則既莫不與之以仁義禮智之性。",
    "ctx": ""
  },
  {
    "id": "v2",
    "type": "异体",
    "shanben": "稟",
    "xiandai": "禀",
    "pos": "2:0",
    "note": "善本「稟」现代本「禀」异体同字",
    "seg": "然其氣質之禀或不能齊，是以不能皆有以知其性之所有而全之也。",
    "ctx": ""
  },
  {
    "id": "v3",
    "type": "异体",
    "shanben": "閒",
    "xiandai": "間",
    "pos": "2:0",
    "note": "善本「閒」现代本「間」异体同字",
    "seg": "一有聰明睿智能盡其性者出於其間，則天必命之以爲億兆之君師，使之治而教之，以復其性。",
    "ctx": ""
  },
  {
    "id": "v4",
    "type": "异体",
    "shanben": "埽",
    "xiandai": "掃",
    "pos": "3:0",
    "note": "善本「埽」现代本「掃」异体同字",
    "seg": "人生八歲，則自王公以下，至於庶人之子弟，皆入小學，而教之以洒掃、應對、進退之節，禮樂、射御、書數之文。",
    "ctx": ""
  },
  {
    "id": "v5",
    "type": "异体",
    "shanben": "彞",
    "xiandai": "彝",
    "pos": "3:0",
    "note": "善本「彞」现代本「彝」异体同字",
    "seg": "夫以學校之設，其廣如此，教之之術，其次第節目之詳又如此，而其所以爲教，則又皆本之人君躬行心得之餘，不待求之民生日用彝倫之外，是以當世之人無不學。",
    "ctx": ""
  },
  {
    "id": "v6",
    "type": "异体",
    "shanben": "丗",
    "xiandai": "世",
    "pos": "3:0",
    "note": "善本「丗」现代本「世」异体同字",
    "seg": "夫以學校之設，其廣如此，教之之術，其次第節目之詳又如此，而其所以爲教，則又皆本之人君躬行心得之餘，不待求之民生日用彝倫之外，是以當世之人無不學。",
    "ctx": ""
  },
  {
    "id": "v7",
    "type": "异体",
    "shanben": "丗",
    "xiandai": "世",
    "pos": "4:0",
    "note": "善本「丗」现代本「世」异体同字",
    "seg": "此古昔盛時所以治隆於上，俗美於下，而非後世之所能及也！",
    "ctx": ""
  },
  {
    "id": "v8",
    "type": "异体",
    "shanben": "頽",
    "xiandai": "頹",
    "pos": "4:0",
    "note": "善本「頽」现代本「頹」异体同字",
    "seg": "及周之衰，賢聖之君不作，學校之政不修，教化陵夷，風俗頹敗。",
    "ctx": ""
  },
  {
    "id": "v9",
    "type": "真异文",
    "shanben": "以",
    "xiandai": "性",
    "pos": "4:0",
    "note": "善本「以」现代本「性」",
    "seg": "時則有若孔子之性下。",
    "ctx": ""
  },
  {
    "id": "v10",
    "type": "真异文",
    "shanben": "行",
    "xiandai": "下",
    "pos": "4:0",
    "note": "善本「行」现代本「下」",
    "seg": "時則有若孔子之性下。",
    "ctx": ""
  },
  {
    "id": "v11",
    "type": "异体",
    "shanben": "丗",
    "xiandai": "世",
    "pos": "4:0",
    "note": "善本「丗」现代本「世」异体同字",
    "seg": "聖，而不得君師之位以行其政教，於是獨取先王之法，誦而傳之，以詔後世。",
    "ctx": ""
  },
  {
    "id": "v12",
    "type": "异体",
    "shanben": "内",
    "xiandai": "內",
    "pos": "4:0",
    "note": "善本「内」现代本「內」异体同字",
    "seg": "若《曲禮》《少儀》《内則》《弟子職》諸篇，固小學之支流餘裔，而此篇者，則因小學之成功，以著大學之明法，外有以極其規模之大，而內有以盡其節目之詳者也。",
    "ctx": ""
  },
  {
    "id": "v13",
    "type": "异体",
    "shanben": "曽",
    "xiandai": "曾",
    "pos": "4:0",
    "note": "善本「曽」现代本「曾」异体同字",
    "seg": "三千之徒，蓋莫不聞其說，而曾氏之傳獨得其宗，於是作爲傳義，以發其意。",
    "ctx": ""
  },
  {
    "id": "v14",
    "type": "异体",
    "shanben": "髙",
    "xiandai": "高",
    "pos": "4:0",
    "note": "善本「髙」现代本「高」异体同字",
    "seg": "異端虛無寂滅之教，其高過於大學而無實。",
    "ctx": ""
  },
  {
    "id": "v15",
    "type": "异体",
    "shanben": "丗",
    "xiandai": "世",
    "pos": "5:0",
    "note": "善本「丗」现代本「世」异体同字",
    "seg": "其他權謀術數，一切以就功名之說，與夫百家衆技之流，所以惑世誣民、充塞仁義者，又紛然雜出乎其間。",
    "ctx": ""
  },
  {
    "id": "v16",
    "type": "异体",
    "shanben": "閒",
    "xiandai": "間",
    "pos": "5:0",
    "note": "善本「閒」现代本「間」异体同字",
    "seg": "其他權謀術數，一切以就功名之說，與夫百家衆技之流，所以惑世誣民、充塞仁義者，又紛然雜出乎其間。",
    "ctx": ""
  },
  {
    "id": "v17",
    "type": "异体",
    "shanben": "旣",
    "xiandai": "既",
    "pos": "5:0",
    "note": "善本「旣」现代本「既」异体同字",
    "seg": "於是河南程氏兩夫子出，而有以接乎孟氏之傳，實始尊信此篇而表章之，既又爲之次其簡編，發其歸趣，然後古者大學教人之法、聖經賢傳之指，粲然復明於世。",
    "ctx": ""
  },
  {
    "id": "v18",
    "type": "异体",
    "shanben": "丗",
    "xiandai": "世",
    "pos": "5:0",
    "note": "善本「丗」现代本「世」异体同字",
    "seg": "於是河南程氏兩夫子出，而有以接乎孟氏之傳，實始尊信此篇而表章之，既又爲之次其簡編，發其歸趣，然後古者大學教人之法、聖經賢傳之指，粲然復明於世。",
    "ctx": ""
  },
  {
    "id": "v19",
    "type": "异体",
    "shanben": "閒",
    "xiandai": "間",
    "pos": "5:0",
    "note": "善本「閒」现代本「間」异体同字",
    "seg": "顧其爲書猶頗放失，是以忘其固陋，采而輯之，間亦竊附己意，補其闕略，以俟後之君子。",
    "ctx": ""
  },
  {
    "id": "v20",
    "type": "异体",
    "shanben": "僣",
    "xiandai": "僭",
    "pos": "5:0",
    "note": "善本「僣」现代本「僭」异体同字",
    "seg": "極知僭踰，無所逃罪，然於國家化民成俗之意、學者修己治人之方，則未必無小補云。",
    "ctx": ""
  },
  {
    "id": "v21",
    "type": "异体",
    "shanben": "稟",
    "xiandai": "禀",
    "pos": "7:0",
    "note": "善本「稟」现代本「禀」异体同字",
    "seg": "但爲氣禀所拘，人欲所蔽，則有時而昏；",
    "ctx": ""
  },
  {
    "id": "v22",
    "type": "异体",
    "shanben": "旣",
    "xiandai": "既",
    "pos": "7:0",
    "note": "善本「旣」现代本「既」异体同字",
    "seg": "言既自明其明德，又當推以及人，使之亦有以去其舊染之污也。",
    "ctx": ""
  },
  {
    "id": "v23",
    "type": "真异文",
    "shanben": "至",
    "xiandai": "止",
    "pos": "7:0",
    "note": "善本「至」现代本「止」",
    "seg": "言明明德、新民，皆當止於至善之地而不遷。",
    "ctx": ""
  },
  {
    "id": "v24",
    "type": "异体",
    "shanben": "旣",
    "xiandai": "既",
    "pos": "9:0",
    "note": "善本「旣」现代本「既」异体同字",
    "seg": "知既盡，則意可得而實矣，意既實，則心可得而正矣。",
    "ctx": ""
  },
  {
    "id": "v25",
    "type": "异体",
    "shanben": "旣",
    "xiandai": "既",
    "pos": "9:0",
    "note": "善本「旣」现代本「既」异体同字",
    "seg": "知既盡，則意可得而實矣，意既實，則心可得而正矣。",
    "ctx": ""
  },
  {
