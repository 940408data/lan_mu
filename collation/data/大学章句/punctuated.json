{
  "schemaVersion": 1,
  "work": "大学章句",
  "status": "draft",
  "orphanCount": 3,
  "segments": [
    {
      "segId": 1,
      "page": 2,
      "text": "大學章句序大學之書古之大學所以教人之法也。"
    },
    {
      "segId": 2,
      "page": 2,
      "text": "蓋自天降生民則旣莫不與之以仁義禮智之性。"
    },
    {
      "segId": 3,
      "page": 2,
      "text": "然其氣質之稟或不能齊是以不能皆有以知其性之所有而全之也。"
    },
    {
      "segId": 4,
      "page": 2,
      "text": "一有聰明睿智能盡其性者出於其閒則天必命之以爲億兆之君師使之治而教之以復其性。"
    },
    {
      "segId": 5,
      "page": 2,
      "text": "此伏羲神農黃帝堯舜所以繼天立極而司徒之職典樂之官所由設也。"
    },
    {
      "segId": 6,
      "page": 3,
      "text": "三代之隆其法寖備然後王宫國都以及閭巷莫不有學。"
    },
    {
      "segId": 7,
      "page": 3,
      "text": "人生八歲則自王公以下至於庶人之子弟皆入小學而教之以洒埽應對進退之節禮樂射御書數之文。"
    },
    {
      "segId": 8,
      "page": 3,
      "text": "及其十有五年則自天子之元子衆子以至公卿大夫元士之適子與凡民之俊秀皆入大學而教之以窮理正心修己治人之道。"
    },
    {
      "segId": 9,
      "page": 3,
      "text": "此又學校之教大小之節所以分也。"
    },
    {
      "segId": 10,
      "page": 3,
      "text": "夫以學校之設其廣如此教之之術其次第節目之詳又如此而其所以爲教則又皆本之人君躬行心得之餘不待求之民生日用彞倫之外是以當丗之人無不學。"
    },
    {
      "segId": 11,
      "page": 3,
      "text": "其學焉者無不有以知其性分之所固有職分之所當爲而各俛焉以盡其力。"
    },
    {
      "segId": 12,
      "page": 4,
      "text": "此古昔盛時所以治隆於上俗美於下而非後丗之所能及也！"
    },
    {
      "segId": 13,
      "page": 4,
      "text": "及周之衰賢聖之君不作學校之政不修教化陵夷風俗頽敗。"
    },
    {
      "segId": 14,
      "page": 4,
      "text": "時則有若孔子之聖而不得君師之位以行"
    },
    {
      "segId": 15,
      "page": 4,
      "text": "聖而不得君師之位以行其政教於是獨取先王之法誦而傳之以詔後丗。"
    },
    {
      "segId": 16,
      "page": 4,
      "text": "若曲禮少儀内則弟子職諸篇固小學之支流餘裔而此篇者則因小學之成功以著大學之明法外有以極其規模之大而内有以盡其節目之詳者也。"
    },
    {
      "segId": 17,
      "page": 4,
      "text": "三千之徒蓋莫不聞其說而曽氏之傳獨得其宗於是作爲傳義以發其意。"
    },
    {
      "segId": 18,
      "page": 4,
      "text": "及孟子没而其傳泯焉則其書雖存而知者鮮矣！"
    },
    {
      "segId": 19,
      "page": 4,
      "text": "自是以來俗儒記誦詞章之習其功倍於小學而無用；"
    },
    {
      "segId": 20,
      "page": 4,
      "text": "異端虛無寂滅之教其髙過於大學而無實。"
    },
    {
      "segId": 21,
      "page": 4,
      "text": "其他權謀術數一切以就功名之說與夫百家衆技之流所以惑丗誣民充塞仁義者又紛然雜出乎其閒。"
    },
    {
      "segId": 22,
      "page": 5,
      "text": "使其君子不幸而不得聞大道之要其小人不幸而不得蒙至治之澤晦盲否塞反覆沈痼以及五季之衰而壞亂極矣！"
    },
    {
      "segId": 23,
      "page": 5,
      "text": "天運循環無往不復。"
    },
    {
      "segId": 24,
      "page": 5,
      "text": "宋德隆盛治教休明。"
    },
    {
      "segId": 25,
      "page": 5,
      "text": "於是河南程氏兩夫子出而有以接乎孟氏之傳實始尊信此篇而表章之旣又爲之次其簡編發其歸趣然後古者大學教人之法聖經賢傳之指粲然復明於丗。"
    },
    {
      "segId": 26,
      "page": 5,
      "text": "雖以熹之不敏亦幸私淑而與有聞焉。"
    },
    {
      "segId": 27,
      "page": 5,
      "text": "顧其爲書猶頗放失是以忘其固陋采而輯之閒亦竊附己意補其闕略以俟後之君子。"
    },
    {
      "segId": 28,
      "page": 5,
      "text": "極知僣踰無所逃罪然於國家化民成俗之意學者修己治人之方則未必無小補云。"
    },
    {
      "segId": 29,
      "page": 6,
      "text": "淳熙己酉二月甲子新安朱熹序。"
    },
    {
      "segId": 30,
      "page": 6,
      "text": "大學朱熹章句大舊音泰今讀如字。"
    },
    {
      "segId": 31,
      "page": 6,
      "text": "子程子曰大學孔氏之遺書而初學入德之門也。"
    },
    {
      "segId": 32,
      "page": 6,
      "text": "於今可見古人爲學次第者獨賴此篇之存而論孟次之。"
    },
    {
      "segId": 33,
      "page": 6,
      "text": "學者必由是而學焉則庶乎其不差矣。"
    },
    {
      "segId": 34,
      "page": 6,
      "text": "大學之道在明明德在親民在止於至善。"
    },
    {
      "segId": 35,
      "page": 7,
      "text": "程子曰親當作新。"
    },
    {
      "segId": 36,
      "page": 7,
      "text": "大學者大人之學也。"
    },
    {
      "segId": 37,
      "page": 7,
      "text": "明明之也。"
    },
    {
      "segId": 38,
      "page": 7,
      "text": "明德者人之所得乎天而虛靈不昧以具衆理而應萬事者也。"
    },
    {
      "segId": 39,
      "page": 7,
      "text": "但爲氣稟所拘人欲所蔽則有時而昏；"
    },
    {
      "segId": 40,
      "page": 7,
      "text": "然其本體之明則有未嘗息者。"
    },
    {
      "segId": 41,
      "page": 7,
      "text": "故學者當因其所發而遂明之以復其初也。"
    },
    {
      "segId": 42,
      "page": 7,
      "text": "新者革其舊之謂也。"
    },
    {
      "segId": 43,
      "page": 7,
      "text": "言旣自明其明德又當推以及人使之亦有以去其舊染之污也。"
    },
    {
      "segId": 44,
      "page": 7,
      "text": "止者必至於是而不遷之意。"
    },
    {
      "segId": 45,
      "page": 7,
      "text": "至善則事理當然之極也。"
    },
    {
      "segId": 46,
      "page": 7,
      "text": "言明明德新民皆當至於至善之地而不遷。"
    },
    {
      "segId": 47,
      "page": 7,
      "text": "蓋必其有以盡夫天理之極而無一毫人欲之私也。"
    },
    {
      "segId": 48,
      "page": 7,
      "text": "此三者大學之綱領也。"
    },
    {
      "segId": 49,
      "page": 7,
      "text": "知止而后有定定而后能靜靜而后能安安而后能慮慮而后能得。"
    },
    {
      "segId": 50,
      "page": 8,
      "text": "後放此。"
    },
    {
      "segId": 51,
      "page": 8,
      "text": "止者所當止之地即至善之所在也。"
    },
    {
      "segId": 52,
      "page": 8,
      "text": "知之則志有定向。"
    },
    {
      "segId": 53,
      "page": 8,
      "text": "靜謂心不妄動。"
    },
    {
      "segId": 54,
      "page": 8,
      "text": "安謂所處而安。"
    },
    {
      "segId": 55,
      "page": 8,
      "text": "慮謂處事精詳。"
    },
    {
      "segId": 56,
      "page": 8,
      "text": "得謂得其所止。"
    },
    {
      "segId": 57,
      "page": 8,
      "text": "物有本末事有終始知所先後則近道矣。"
    },
    {
      "segId": 58,
      "page": 8,
      "text": "明德爲本新民爲末。"
    },
    {
      "segId": 59,
      "page": 8,
      "text": "知止爲始能得爲終。"
    },
    {
      "segId": 60,
      "page": 8,
      "text": "本始所先末終所後。"
    },
    {
      "segId": 61,
      "page": 8,
      "text": "此結上文兩節之意。"
    },
    {
      "segId": 62,
      "page": 8,
      "text": "古之欲明明德於天下者先治其國；"
    },
    {
      "segId": 63,
      "page": 8,
      "text": "欲治其國者先齊其家；"
    },
    {
      "segId": 64,
      "page": 8,
      "text": "欲齊其家者先脩其身；"
    },
    {
      "segId": 65,
      "page": 8,
      "text": "欲脩其身者先正其心；"
    },
    {
      "segId": 66,
      "page": 8,
      "text": "欲正其心者先誠其意；"
    },
    {
      "segId": 67,
      "page": 8,
      "text": "欲誠其意者先致其知；"
    },
    {
      "segId": 68,
      "page": 8,
      "text": "致知在格物。"
    },
    {
      "segId": 69,
      "page": 8,
      "text": "治平聲。"
    },
    {
      "segId": 70,
      "page": 8,
      "text": "後放此。"
    },
    {
      "segId": 71,
      "page": 8,
      "text": "明明德於天下者使天下之人皆有以明其明德也。"
    },
    {
      "segId": 72,
      "page": 8,
      "text": "心者身之所主也。"
    },
    {
      "segId": 73,
      "page": 9,
      "text": "誠實也。"
    },
    {
      "segId": 74,
      "page": 9,
      "text": "意者心之所發也。"
    },
    {
      "segId": 75,
      "page": 9,
      "text": "實其心之所發欲其一於善而無自欺也。"
    },
    {
      "segId": 76,
      "page": 9,
      "text": "致推極也。"
    },
    {
      "segId": 77,
      "page": 9,
      "text": "知猶識也。"
    },
    {
      "segId": 78,
      "page": 9,
      "text": "推極吾之知識欲其所知無不盡也。"
    },
    {
      "segId": 79,
      "page": 9,
      "text": "格至也。"
    },
    {
      "segId": 80,
      "page": 9,
      "text": "物猶事也。"
    },
    {
      "segId": 81,
      "page": 9,
      "text": "窮至事物之理欲其極處無不到也。"
    },
    {
      "segId": 82,
      "page": 9,
      "text": "此八者大學之條目也。"
    },
    {
      "segId": 83,
      "page": 9,
      "text": "物格而后知至知至而后意誠意誠而后心正心正而后身脩身脩而后家齊家齊而后國治國治而后天下平。"
    },
    {
      "segId": 84,
      "page": 9,
      "text": "治去聲。"
    },
    {
      "segId": 85,
      "page": 9,
      "text": "後放此。"
    },
    {
      "segId": 86,
      "page": 9,
      "text": "物格者物理之極處無不到也。"
    },
    {
      "segId": 87,
      "page": 9,
      "text": "知至者吾心之所知無不盡也。"
    },
    {
      "segId": 88,
      "page": 9,
      "text": "知旣盡則意可得而實矣意旣實則心可得而正矣。"
    },
    {
      "segId": 89,
      "page": 9,
      "text": "脩身以上明明德之事也。"
    },
    {
      "segId": 90,
      "page": 9,
      "text": "齊家以下新民之事也。"
    },
    {
      "segId": 91,
      "page": 9,
      "text": "物格知至則知所止矣。"
    },
    {
      "segId": 92,
      "page": 9,
      "text": "意誠以下則皆得所止之序也。"
    },
    {
      "segId": 93,
      "page": 10,
      "text": "自天子以至於庶人壹是皆以脩身爲本。"
    },
    {
      "segId": 94,
      "page": 10,
      "text": "壹是一切也。"
    },
    {
      "segId": 95,
      "page": 10,
      "text": "正心以上皆所以脩身也。"
    },
    {
      "segId": 96,
      "page": 10,
      "text": "齊家以下則舉此而錯之耳。"
    },
    {
      "segId": 97,
      "page": 10,
      "text": "其本亂而末治者否矣。"
    },
    {
      "segId": 98,
      "page": 10,
      "text": "其所厚者薄而其所薄者厚未之有也。"
    },
    {
      "segId": 99,
      "page": 10,
      "text": "本謂身也。"
    },
    {
      "segId": 100,
      "page": 10,
      "text": "所厚謂家也。"
    },
    {
      "segId": 101,
      "page": 10,
      "text": "此兩節結上文兩節之意。"
    },
    {
      "segId": 102,
      "page": 10,
      "text": "右經一章蓋孔子之言而曾子述之。"
    },
    {
      "segId": 103,
      "page": 10,
      "text": "凡二百五字。"
    },
    {
      "segId": 104,
      "page": 10,
      "text": "其傳十章則曾子之意而門人記之也。"
    },
    {
      "segId": 105,
      "page": 10,
      "text": "舊本頗有錯簡今因程子所定而更考經文别爲序次如左。"
    },
    {
      "segId": 106,
      "page": 10,
      "text": "凡千五百四十六字。"
    },
    {
      "segId": 107,
      "page": 10,
      "text": "凡傳文雜引經傳若無統紀然文理接續血脉貫通深淺始終至爲精密。"
    },
    {
      "segId": 108,
      "page": 10,
      "text": "熟讀詳味乆當見之今不盡釋也。"
    },
    {
      "segId": 109,
      "page": 11,
      "text": "康誥曰克明德。"
    },
    {
      "segId": 110,
      "page": 11,
      "text": "康誥周書。"
    },
    {
      "segId": 111,
      "page": 11,
      "text": "克能也。"
    },
    {
      "segId": 112,
      "page": 11,
      "text": "大甲曰顧諟天之明命。"
    },
    {
      "segId": 113,
      "page": 11,
      "text": "大讀作泰。"
    },
    {
      "segId": 114,
      "page": 11,
      "text": "諟古是字。"
    },
    {
      "segId": 115,
      "page": 11,
      "text": "大甲商書。"
    },
    {
      "segId": 116,
      "page": 11,
      "text": "顧謂常目在之也。"
    },
    {
      "segId": 117,
      "page": 11,
      "text": "諟猶此也或曰審也。"
    },
    {
      "segId": 118,
      "page": 11,
      "text": "天之明命即天之所以與我而我之所以爲德者也。"
    },
    {
      "segId": 119,
      "page": 11,
      "text": "常目在之則無時不明矣。"
    },
    {
      "segId": 120,
      "page": 11,
      "text": "帝典曰克明峻德。"
    },
    {
      "segId": 121,
      "page": 11,
      "text": "峻書作俊。"
    },
    {
      "segId": 122,
      "page": 11,
      "text": "帝典堯典虞書。"
    },
    {
      "segId": 123,
      "page": 11,
      "text": "峻大也。"
    },
    {
      "segId": 124,
      "page": 11,
      "text": "皆自明也。"
    },
    {
      "segId": 125,
      "page": 11,
      "text": "結所引書皆言自明己德之意。"
    },
    {
      "segId": 126,
      "page": 11,
      "text": "右傳之首章。"
    },
    {
      "segId": 127,
      "page": 11,
      "text": "釋明明德。"
    },
    {
      "segId": 128,
      "page": 11,
      "text": "此通下三章至止於信舊本誤在没世不忘之下。"
    },
    {
      "segId": 129,
      "page": 12,
      "text": "湯之盤銘曰苟日新日日新又日新。"
    },
    {
      "segId": 130,
      "page": 12,
      "text": "盤沐浴之盤也。"
    },
    {
      "segId": 131,
      "page": 12,
      "text": "銘名其器以自警之辭也。"
    },
    {
      "segId": 132,
      "page": 12,
      "text": "苟誠也。"
    },
    {
      "segId": 133,
      "page": 12,
      "text": "湯以人之洗濯其心以去惡如沐浴其身以去垢。"
    },
    {
      "segId": 134,
      "page": 12,
      "text": "故銘其盤言誠能一日有以滌其舊染之污而自新則當因其巳新者而日曰新之。"
    },
    {
      "segId": 136,
      "page": 12,
      "text": "康誥曰作新民。"
    },
    {
      "segId": 137,
      "page": 12,
      "text": "鼓之舞之之謂作。"
    },
    {
      "segId": 138,
      "page": 12,
      "text": "言振起其自新之民也。"
    },
    {
      "segId": 139,
      "page": 12,
      "text": "詩曰周雖舊邦其命惟新。"
    },
    {
      "segId": 140,
      "page": 12,
      "text": "詩大雅文王之篇。"
    },
    {
      "segId": 141,
      "page": 12,
      "text": "言周國雖舊至於文王能新其德以及於民而始受天命也。"
    },
    {
      "segId": 142,
      "page": 12,
      "text": "是故君子無所不用其極。"
    },
    {
      "segId": 143,
      "page": 12,
      "text": "自新新民皆欲止於至善也。"
    },
    {
      "segId": 144,
      "page": 13,
      "text": "右傳之二章。"
    },
    {
      "segId": 145,
      "page": 13,
      "text": "釋新民。"
    },
    {
      "segId": 146,
      "page": 13,
      "text": "詩云邦畿千里惟民所止。"
    },
    {
      "segId": 147,
      "page": 13,
      "text": "詩商頌玄鳥之篇。"
    },
    {
      "segId": 148,
      "page": 13,
      "text": "邦畿王者之都也。"
    },
    {
      "segId": 149,
      "page": 13,
      "text": "止居也言物各有所當止之處也。"
    },
    {
      "segId": 150,
      "page": 13,
      "text": "詩云緡蠻黃鳥止于丘隅。"
    },
    {
      "segId": 151,
      "page": 13,
      "text": "子曰於止知其所止可以人而不如鳥乎！"
    },
    {
      "segId": 152,
      "page": 13,
      "text": "緡詩作綿詩小雅綿蠻之篇緡。"
    },
    {
      "segId": 154,
      "page": 13,
      "text": "緡蠻鳥聲。"
    },
    {
      "segId": 155,
      "page": 13,
      "text": "丘隅岑蔚之處。"
    },
    {
      "segId": 156,
      "page": 13,
      "text": "子曰以下孔子說詩之辭言人當知所當止之處也。"
    },
    {
      "segId": 157,
      "page": 13,
      "text": "詩云穆穆文王於緝熙敬止！"
    },
    {
      "segId": 158,
      "page": 13,
      "text": "爲人君止於仁；"
    },
    {
      "segId": 159,
      "page": 13,
      "text": "爲人臣止於敬；"
    },
    {
      "segId": 160,
      "page": 13,
      "text": "爲人子止於孝；"
    },
    {
      "segId": 161,
      "page": 13,
      "text": "爲人父止於慈；"
    },
    {
      "segId": 162,
      "page": 13,
      "text": "與國人交止於信。"
    },
    {
      "segId": 163,
      "page": 13,
      "text": "於緝之於音烏。"
    },
    {
      "segId": 164,
      "page": 13,
      "text": "詩文王之篇。"
    },
    {
      "segId": 165,
      "page": 13,
      "text": "穆穆深逺之意。"
    },
    {
      "segId": 166,
      "page": 13,
      "text": "於歎美辭。"
    },
    {
      "segId": 167,
      "page": 13,
      "text": "緝繼續也。"
    },
    {
      "segId": 168,
      "page": 13,
      "text": "熙光明也。"
    },
    {
      "segId": 169,
      "page": 13,
      "text": "敬止言其無不敬而安所止也。"
    },
    {
      "segId": 170,
      "page": 13,
      "text": "引此而言聖人之止無非至善。"
    },
    {
      "segId": 171,
      "page": 13,
      "text": "五者乃其目之大者也。"
    },
    {
      "segId": 172,
      "page": 14,
      "text": "學者於此究其精微之蘊而又推類以盡其餘則於天下之事皆有以知其所止而無疑矣。"
    },
    {
      "segId": 173,
      "page": 14,
      "text": "詩云瞻彼淇澳菉竹猗猗。"
    },
    {
      "segId": 174,
      "page": 14,
      "text": "有斐君子如切如磋如琢如磨。"
    },
    {
      "segId": 175,
      "page": 14,
      "text": "瑟兮僩兮赫兮喧兮。"
    },
    {
      "segId": 176,
      "page": 14,
      "text": "有斐君子終不可諠兮！"
    },
    {
      "segId": 177,
      "page": 14,
      "text": "如切如磋者道學也。"
    },
    {
      "segId": 178,
      "page": 14,
      "text": "如琢如磨者自脩也。"
    },
    {
      "segId": 179,
      "page": 14,
      "text": "瑟兮僩兮者恂慄也。"
    },
    {
      "segId": 180,
      "page": 14,
      "text": "赫兮喧兮者威儀也。"
    },
    {
      "segId": 181,
      "page": 14,
      "text": "有斐君子終不可諠兮者道盛德至善民之不能忘也。"
    },
    {
      "segId": 182,
      "page": 14,
      "text": "澳於六反。"
    },
    {
      "segId": 183,
      "page": 14,
      "text": "菉詩作緑。"
    },
    {
      "segId": 184,
      "page": 14,
      "text": "猗叶韻音"
    },
    {
      "segId": 185,
      "page": 14,
      "text": "阿。"
    },
    {
      "segId": 186,
      "page": 14,
      "text": "僩下版反。"
    },
    {
      "segId": 187,
      "page": 14,
      "text": "喧詩作咺；"
    },
    {
      "segId": 188,
      "page": 14,
      "text": "諠詩作諼並况晚反。"
    },
    {
      "segId": 189,
      "page": 14,
      "text": "恂鄭氏讀作峻。"
    },
    {
      "segId": 190,
      "page": 14,
      "text": "詩衛風淇澳之篇。"
    },
    {
      "segId": 191,
      "page": 14,
      "text": "淇水名。"
    },
    {
      "segId": 192,
      "page": 14,
      "text": "澳隈也。"
    },
    {
      "segId": 193,
      "page": 14,
      "text": "猗猗美盛貌。"
    },
    {
      "segId": 194,
      "page": 14,
      "text": "興也。"
    },
    {
      "segId": 195,
      "page": 14,
      "text": "斐文貌。"
    },
    {
      "segId": 196,
      "page": 14,
      "text": "切以刀鋸琢以椎鑿皆裁物使成形質也。"
    },
    {
      "segId": 197,
      "page": 14,
      "text": "磋以鑢錫磨以沙石皆治物使其滑澤也。"
    },
    {
      "segId": 198,
      "page": 15,
      "text": "治骨角者旣切而復磋之。"
    },
    {
      "segId": 199,
      "page": 15,
      "text": "治玉石者旣琢而復磨之。"
    },
    {
      "segId": 200,
      "page": 15,
      "text": "皆言其治之有緒而益致其精也。"
    },
    {
      "segId": 201,
      "page": 15,
      "text": "瑟嚴密之貌。"
    },
    {
      "segId": 202,
      "page": 15,
      "text": "僩武毅之貌。"
    },
    {
      "segId": 203,
      "page": 15,
      "text": "赫喧宣著盛大之貌。"
    },
    {
      "segId": 204,
      "page": 15,
      "text": "諠忘也。"
    },
    {
      "segId": 205,
      "page": 15,
      "text": "道言也。"
    },
    {
      "segId": 206,
      "page": 15,
      "text": "學謂講習討論之事。"
    },
    {
      "segId": 207,
      "page": 15,
      "text": "自脩者省察克治之功。"
    },
    {
      "segId": 208,
      "page": 15,
      "text": "恂慄戰懼也。"
    },
    {
      "segId": 209,
      "page": 15,
      "text": "威可畏也。"
    },
    {
      "segId": 210,
      "page": 15,
      "text": "儀可象也。"
    },
    {
      "segId": 211,
      "page": 15,
      "text": "引詩而釋之以明明明德者之止於至善。"
    },
    {
      "segId": 212,
      "page": 15,
      "text": "道學自脩言其所以得之之由。"
    },
    {
      "segId": 213,
      "page": 15,
      "text": "恂慄威儀言其德容表裏之盛。"
    },
    {
      "segId": 214,
      "page": 15,
      "text": "卒乃指其實而歎美之也。"
    },
    {
      "segId": 215,
      "page": 15,
      "text": "詩云於戲前王不忘！"
    },
    {
      "segId": 216,
      "page": 15,
      "text": "君子賢其賢而親其親小人樂其樂而利其利此以没丗不忘也。"
    },
    {
      "segId": 217,
      "page": 15,
      "text": "於戲音嗚呼。"
    },
    {
      "segId": 218,
      "page": 15,
      "text": "樂音洛。"
    },
    {
      "segId": 219,
      "page": 15,
      "text": "詩周頌烈文之篇。"
    },
    {
      "segId": 220,
      "page": 15,
      "text": "於戲嘆辭。"
    },
    {
      "segId": 221,
      "page": 15,
      "text": "前王謂文武也。"
    },
    {
      "segId": 222,
      "page": 15,
      "text": "君子謂其後賢後王。"
    },
    {
      "segId": 223,
      "page": 16,
      "text": "小人謂後民也。"
    },
    {
      "segId": 224,
      "page": 16,
      "text": "此言前王所以新民者止於至善能使天下後丗無一物不得其所所以旣没丗而人思慕之愈乆而不忘也。"
    },
    {
      "segId": 225,
      "page": 16,
      "text": "此兩節詠歎滛泆其味深長當熟玩之。"
    },
    {
      "segId": 226,
      "page": 16,
      "text": "右傳之三章。"
    },
    {
      "segId": 227,
      "page": 16,
      "text": "釋止於至善。"
    },
    {
      "segId": 228,
      "page": 16,
      "text": "此章内自引淇澳詩以下舊本誤在誠意章下。"
    },
    {
      "segId": 229,
      "page": 16,
      "text": "子曰聽訟吾猶人也必也使無訟乎！"
    },
    {
      "segId": 230,
      "page": 16,
      "text": "無情者不得盡其辭大畏民志。"
    },
    {
      "segId": 231,
      "page": 16,
      "text": "此謂知本。"
    },
    {
      "segId": 232,
      "page": 16,
      "text": "猶人不異於人也。"
    },
    {
      "segId": 233,
      "page": 16,
      "text": "情實也。"
    },
    {
      "segId": 234,
      "page": 16,
      "text": "引夫子之言而言聖人能使無實之人不敢盡其虛誕之辭。"
    },
    {
      "segId": 235,
      "page": 16,
      "text": "蓋我之明德旣明自然有以畏服民之心志故訟不待聽而自無也。"
    },
    {
      "segId": 236,
      "page": 16,
      "text": "觀於此言可以知本末之先後矣。"
    },
    {
      "segId": 237,
      "page": 17,
      "text": "右傳之四章。"
    },
    {
      "segId": 238,
      "page": 17,
      "text": "釋本末。"
    },
    {
      "segId": 239,
      "page": 17,
      "text": "此章舊本誤在止於信下。"
    },
    {
      "segId": 240,
      "page": 17,
      "text": "此謂知本程子曰衍文也。"
    },
    {
      "segId": 241,
      "page": 17,
      "text": "此謂知之至也。"
    },
    {
      "segId": 242,
      "page": 17,
      "text": "此句之上别有闕文此特其結語耳。"
    },
    {
      "segId": 243,
      "page": 17,
      "text": "右傳之五章。"
    },
    {
      "segId": 244,
      "page": 17,
      "text": "蓋釋格物致知之義而今云矣。"
    },
    {
      "segId": 245,
      "page": 17,
      "text": "此章舊本通下章誤在經文之下。"
    },
    {
      "segId": 246,
      "page": 17,
      "text": "閒嘗竊取程子之意以補之曰所謂致知在格物者言欲致吾之知在即物而窮其理也。"
    },
    {
      "segId": 247,
      "page": 17,
      "text": "蓋人心之靈莫不有知而天下之物莫不有理惟於理有未窮故其知有不盡也。"
    },
    {
      "segId": 248,
      "page": 17,
      "text": "是以大學始教必使學者即凡天下之物莫不因其巳知之理而益窮之以求至乎其極。"
    },
    {
      "segId": 249,
      "page": 18,
      "text": "至於用力之乆而一旦豁然貫通焉則衆物之表裏精粗無不到而吾心之全體大用無不明矣。"
    },
    {
      "segId": 250,
      "page": 18,
      "text": "此謂物格此謂知之至也。"
    },
    {
      "segId": 251,
      "page": 18,
      "text": "所謂誠其意者毋自欺也。"
    },
    {
      "segId": 252,
      "page": 18,
      "text": "如惡惡臭如好好色此之謂自謙。"
    },
    {
      "segId": 253,
      "page": 18,
      "text": "故君子必慎其獨也！"
    },
    {
      "segId": 254,
      "page": 18,
      "text": "惡好上字皆去聲。"
    },
    {
      "segId": 255,
      "page": 18,
      "text": "謙讀爲慊苦刼反。"
    },
    {
      "segId": 256,
      "page": 18,
      "text": "誠其意者自脩之首也。"
    },
    {
      "segId": 257,
      "page": 18,
      "text": "毋者禁止之辭。"
    },
    {
      "segId": 258,
      "page": 18,
      "text": "自欺云者知爲善以去惡而心之所發有未實也。"
    },
    {
      "segId": 259,
      "page": 18,
      "text": "慊快也足也。"
    },
    {
      "segId": 260,
      "page": 18,
      "text": "獨者人"
    },
    {
      "segId": 261,
      "page": 18,
      "text": "所不知而巳所獨知之地也。"
    },
    {
      "segId": 262,
      "page": 18,
      "text": "言欲自脩者知爲善以去其惡則當實用其力而禁止其自欺。"
    },
    {
      "segId": 263,
      "page": 18,
      "text": "使其惡惡則如惡惡臭好善則如好好色皆務決去而求必得之以自快足於己不可徒苟且以徇外而爲人也。"
    },
    {
      "segId": 264,
      "page": 19,
      "text": "然其實與不實蓋有他人所不及知而己獨知之者故必謹之於此以審其幾焉。"
    },
    {
      "segId": 265,
      "page": 19,
      "text": "小人閒居爲不善無所不至見君子而后厭然揜其不善而著其善。"
    },
    {
      "segId": 266,
      "page": 19,
      "text": "人之視己如見其肺肝然則何益矣。"
    },
    {
      "segId": 267,
      "page": 19,
      "text": "此謂誠於中形於外故君子必慎其獨也。"
    },
    {
      "segId": 268,
      "page": 19,
      "text": "閒音閑。"
    },
    {
      "segId": 269,
      "page": 19,
      "text": "厭鄭氏讀爲黶。"
    },
    {
      "segId": 270,
      "page": 19,
      "text": "閒居獨處也。"
    },
    {
      "segId": 271,
      "page": 19,
      "text": "厭然銷沮閉藏之貌。"
    },
    {
      "segId": 272,
      "page": 19,
      "text": "此言小人隂爲不善而陽欲揜之則是非不知善之當爲與惡之當去也但不能實用其力以至此耳。"
    },
    {
      "segId": 273,
      "page": 19,
      "text": "然欲揜其惡而卒不可揜欲詐爲善而卒不可詐則亦何益之有哉！"
    },
    {
      "segId": 274,
      "page": 19,
      "text": "此君子所以重以爲戒而必謹其獨也。"
    },
    {
      "segId": 275,
      "page": 20,
      "text": "曾子曰十目所視十手所指其嚴乎！"
    },
    {
      "segId": 276,
      "page": 20,
      "text": "引此以明上文之意。"
    },
    {
      "segId": 277,
      "page": 20,
      "text": "言雖幽獨之中而其善惡之不可揜如此可畏之甚也。"
    },
    {
      "segId": 279,
      "page": 20,
      "text": "富潤屋德潤身心廣體胖故君子必誠其意胖步丹反。"
    },
    {
      "segId": 280,
      "page": 20,
      "text": "胖安舒也。"
    },
    {
      "segId": 281,
      "page": 20,
      "text": "言富則能潤屋矣德則能潤身矣故心無愧怍則廣大寬平而體常舒泰德之潤身者然也。"
    },
    {
      "segId": 282,
      "page": 20,
      "text": "蓋善之實於中而形於外者如此故又言此以結之。"
    },
    {
      "segId": 283,
      "page": 20,
      "text": "右傳之六章。"
    },
    {
      "segId": 284,
      "page": 20,
      "text": "釋誠意。"
    },
    {
      "segId": 285,
      "page": 20,
      "text": "經曰欲誠其意先致其知。"
    },
    {
      "segId": 286,
      "page": 20,
      "text": "又曰知至而后意誠。"
    },
    {
      "segId": 287,
      "page": 20,
      "text": "蓋心體之明有所未盡則其所發必有不能實用其力而苟焉以自欺者。"
    },
    {
      "segId": 288,
      "page": 21,
      "text": "然或巳明而不"
    },
    {
      "segId": 289,
      "page": 21,
      "text": "謹乎此則其所明又非已有而無以爲進德之基。"
    },
    {
      "segId": 290,
      "page": 21,
      "text": "故此章之指必承上章而通考之然後有以見其用力之始終其序不可亂而功不可闕如此云。"
    },
    {
      "segId": 291,
      "page": 21,
      "text": "所謂脩身在正其心者身有所忿懥則不得其正；"
    },
    {
      "segId": 292,
      "page": 21,
      "text": "有所恐懼則不得其正；"
    },
    {
      "segId": 293,
      "page": 21,
      "text": "有所好樂則不得其正；"
    },
    {
      "segId": 294,
      "page": 21,
      "text": "有所憂患則不得其正。"
    },
    {
      "segId": 295,
      "page": 21,
      "text": "程子曰身有之身當作心。"
    },
    {
      "segId": 296,
      "page": 21,
      "text": "忿弗粉反。"
    },
    {
      "segId": 297,
      "page": 21,
      "text": "懥敕值反。"
    },
    {
      "segId": 298,
      "page": 21,
      "text": "好樂並去聲。"
    },
    {
      "segId": 299,
      "page": 21,
      "text": "忿懥怒也。"
    },
    {
      "segId": 300,
      "page": 21,
      "text": "蓋是四者皆心之用而人所不能無者。"
    },
    {
      "segId": 301,
      "page": 21,
      "text": "然一有之而不能察則欲動情勝而其用之所行或不能不失其正矣。"
    },
    {
      "segId": 302,
      "page": 21,
      "text": "心不在焉視而不見聽而不聞食而不知其味。"
    },
    {
      "segId": 303,
      "page": 22,
      "text": "心有不存則無以檢其身是以君子必察乎此而敬以直之然後此心常存而身無不脩也。"
    },
    {
      "segId": 304,
      "page": 22,
      "text": "此謂脩身在正其心。"
    },
    {
      "segId": 305,
      "page": 22,
      "text": "右傳之七章。"
    },
    {
      "segId": 306,
      "page": 22,
      "text": "釋正心脩身。"
    },
    {
      "segId": 307,
      "page": 22,
      "text": "此亦承上章以起下章。"
    },
    {
      "segId": 308,
      "page": 22,
      "text": "蓋意誠則眞無惡而實有善矣所以能存是心以檢其身。"
    },
    {
      "segId": 309,
      "page": 22,
      "text": "然或但知誠意而不能密察此心之存否則又無以直内而脩身也。"
    },
    {
      "segId": 310,
      "page": 22,
      "text": "自此以下並以舊文爲正。"
    },
    {
      "segId": 311,
      "page": 22,
      "text": "所謂齊其家在脩其身者人之其所親愛而辟焉之其所賤惡而辟焉之其所畏敬而辟焉之其所哀矜而辟焉之其所敖惰而辟焉。"
    },
    {
      "segId": 312,
      "page": 22,
      "text": "故好而知其惡惡而知其美者天下鮮矣。"
    },
    {
      "segId": 313,
      "page": 23,
      "text": "辟讀爲僻。"
    },
    {
      "segId": 314,
      "page": 23,
      "text": "惡而之惡敖好並去聲。"
    },
    {
      "segId": 315,
      "page": 23,
      "text": "鮮上聲。"
    },
    {
      "segId": 316,
      "page": 23,
      "text": "人謂衆人。"
    },
    {
      "segId": 317,
      "page": 23,
      "text": "之猶於也。"
    },
    {
      "segId": 318,
      "page": 23,
      "text": "辟猶偏也。"
    },
    {
      "segId": 319,
      "page": 23,
      "text": "五者在人本有當然之則然常人之情惟其所向而不加審焉則必陷於"
    },
    {
      "segId": 320,
      "page": 23,
      "text": "一偏而身不脩矣。"
    },
    {
      "segId": 321,
      "page": 23,
      "text": "故諺有之曰人莫知其子之惡莫知其苗之碩。"
    },
    {
      "segId": 322,
      "page": 23,
      "text": "諺音彦。"
    },
    {
      "segId": 323,
      "page": 23,
      "text": "碩叶韻時若反。"
    },
    {
      "segId": 324,
      "page": 23,
      "text": "諺俗語也。"
    },
    {
      "segId": 325,
      "page": 23,
      "text": "溺愛者不明貪得者無厭是則偏之爲害而家之所以不齊也。"
    },
    {
      "segId": 326,
      "page": 23,
      "text": "此謂身不脩不可以齊其家右傳之八章。"
    },
    {
      "segId": 327,
      "page": 23,
      "text": "釋脩身齊家。"
    },
    {
      "segId": 328,
      "page": 23,
      "text": "所謂治國必先齊其家者其家不可教而能教人者無之。"
    },
    {
      "segId": 329,
      "page": 23,
      "text": "故君子不出家而成教於國孝者所以事君也；"
    },
    {
      "segId": 330,
      "page": 23,
      "text": "弟者所以事長也；"
    },
    {
      "segId": 331,
      "page": 24,
      "text": "慈者所以使衆也。"
    },
    {
      "segId": 332,
      "page": 24,
      "text": "弟去聲。"
    },
    {
      "segId": 333,
      "page": 24,
      "text": "長上聲。"
    },
    {
      "segId": 334,
      "page": 24,
      "text": "身脩則家可教矣；"
    },
    {
      "segId": 335,
      "page": 24,
      "text": "孝弟慈所以脩身而教於家者也；"
    },
    {
      "segId": 336,
      "page": 24,
      "text": "然而國之所以事君事長使衆之道不外乎此。"
    },
    {
      "segId": 337,
      "page": 24,
      "text": "此所以家齊於上而教成於下也。"
    },
    {
      "segId": 338,
      "page": 24,
      "text": "康誥曰如保赤子。"
    },
    {
      "segId": 339,
      "page": 24,
      "text": "心誠求之雖不中不遠矣。"
    },
    {
      "segId": 340,
      "page": 24,
      "text": "未有學養子而后嫁者也。"
    },
    {
      "segId": 341,
      "page": 24,
      "text": "中去聲。"
    },
    {
      "segId": 342,
      "page": 24,
      "text": "此引書而釋之又明立教之本不假強爲在識其端而推廣之耳。"
    },
    {
      "segId": 343,
      "page": 24,
      "text": "一家仁一國興仁；"
    },
    {
      "segId": 344,
      "page": 24,
      "text": "一家讓一國興讓；"
    },
    {
      "segId": 345,
      "page": 24,
      "text": "一人貪戾一國作亂其機如此。"
    },
    {
      "segId": 346,
      "page": 24,
      "text": "此謂一言僨事一人定國。"
    },
    {
      "segId": 347,
      "page": 24,
      "text": "僨音奮。"
    },
    {
      "segId": 348,
      "page": 24,
      "text": "一人謂君也。"
    },
    {
      "segId": 349,
      "page": 24,
      "text": "機發動所由也。"
    },
    {
      "segId": 350,
      "page": 24,
      "text": "僨覆敗也。"
    },
    {
      "segId": 351,
      "page": 24,
      "text": "此言教成於國之效。"
    },
    {
      "segId": 352,
      "page": 25,
      "text": "堯舜帥天下以仁而民從之；"
    },
    {
      "segId": 353,
      "page": 25,
      "text": "桀紂帥天下以暴而民從之；"
    },
    {
      "segId": 354,
      "page": 25,
      "text": "其所令反其所好而民不從。"
    },
    {
      "segId": 355,
      "page": 25,
      "text": "是故君子有諸己而后求諸人所藏乎身不恕而能喻諸人。"
    },
    {
      "segId": 356,
      "page": 25,
      "text": "所藏乎身不恕而能喻諸人者未之有也。"
    },
    {
      "segId": 357,
      "page": 25,
      "text": "好去聲。"
    },
    {
      "segId": 358,
      "page": 25,
      "text": "此又承上文一人定國而言。"
    },
    {
      "segId": 359,
      "page": 25,
      "text": "有善於己然後可以責人之善；"
    },
    {
      "segId": 360,
      "page": 25,
      "text": "無惡於己然後可以正人之惡。"
    },
    {
      "segId": 361,
      "page": 25,
      "text": "皆推己以及人所謂恕也。"
    },
    {
      "segId": 362,
      "page": 25,
      "text": "不如是則所令反其所好而民不從矣。"
    },
    {
      "segId": 363,
      "page": 25,
      "text": "喻曉也。"
    },
    {
      "segId": 364,
      "page": 25,
      "text": "故治國在齊其家。"
    },
    {
      "segId": 365,
      "page": 25,
      "text": "通結上文。"
    },
    {
      "segId": 366,
      "page": 25,
      "text": "詩云桃之夭夭其葉蓁蓁；"
    },
    {
      "segId": 367,
      "page": 25,
      "text": "之子于歸宜其家人。"
    },
    {
      "segId": 368,
      "page": 25,
      "text": "宜其家人而后可以教國人。"
    },
    {
      "segId": 369,
      "page": 25,
      "text": "夭平聲。"
    },
    {
      "segId": 370,
      "page": 25,
      "text": "蓁音臻。"
    },
    {
      "segId": 371,
      "page": 25,
      "text": "詩周南桃夭之篇。"
    },
    {
      "segId": 372,
      "page": 25,
      "text": "夭夭少好貌。"
    },
    {
      "segId": 373,
      "page": 25,
      "text": "蓁蓁美盛貌。"
    },
    {
      "segId": 374,
      "page": 25,
      "text": "興也。"
    },
    {
      "segId": 375,
      "page": 25,
      "text": "之子猶言是子此指女子之嫁者而言也。"
    },
    {
      "segId": 376,
      "page": 26,
      "text": "婦人謂嫁曰歸。"
    },
    {
      "segId": 377,
      "page": 26,
      "text": "宜猶善也。"
    },
    {
      "segId": 378,
      "page": 26,
      "text": "詩云宜兄宜弟。"
    },
    {
      "segId": 379,
      "page": 26,
      "text": "宜兄宜弟而后可以教國人。"
    },
    {
      "segId": 380,
      "page": 26,
      "text": "詩小雅蓼蕭篇。"
    },
    {
      "segId": 381,
      "page": 26,
      "text": "詩云其儀不忒正是四國。"
    },
    {
      "segId": 382,
      "page": 26,
      "text": "其爲父子兄弟足法而后民法之也。"
    },
    {
      "segId": 383,
      "page": 26,
      "text": "詩曹風鳴鳩篇。"
    },
    {
      "segId": 384,
      "page": 26,
      "text": "忒差也。"
    },
    {
      "segId": 385,
      "page": 26,
      "text": "此謂治國在齊其家。"
    },
    {
      "segId": 386,
      "page": 26,
      "text": "此三引詩皆以咏歎上文之事而又結之如此。"
    },
    {
      "segId": 387,
      "page": 26,
      "text": "其味深長最宜潛玩。"
    },
    {
      "segId": 388,
      "page": 26,
      "text": "右傳之九章。"
    },
    {
      "segId": 389,
      "page": 26,
      "text": "釋齊家治國。"
    },
    {
      "segId": 390,
      "page": 26,
      "text": "所謂平天下在治其國者上老老而民興孝上長長而民興弟上恤孤而民不倍是以君子有絜矩之道也。"
    },
    {
      "segId": 391,
      "page": 26,
      "text": "長上聲。"
    },
    {
      "segId": 392,
      "page": 26,
      "text": "弟去聲。"
    },
    {
      "segId": 393,
      "page": 26,
      "text": "倍與背同。"
    },
    {
      "segId": 394,
      "page": 26,
      "text": "絜胡結反。"
    },
    {
      "segId": 395,
      "page": 27,
      "text": "老老所謂老吾老也。"
    },
    {
      "segId": 396,
      "page": 27,
      "text": "興謂有所感發而興起也。"
    },
    {
      "segId": 397,
      "page": 27,
      "text": "孤者㓜而無父之稱。"
    },
    {
      "segId": 398,
      "page": 27,
      "text": "絜度也。"
    },
    {
      "segId": 399,
      "page": 27,
      "text": "矩所以爲方也。"
    },
    {
      "segId": 400,
      "page": 27,
      "text": "言此三者上行下效捷於影響所謂家齊而國治也。"
    },
    {
      "segId": 401,
      "page": 27,
      "text": "亦可以見人心之所同而不可使有一夫之不獲矣。"
    },
    {
      "segId": 402,
      "page": 27,
      "text": "是以君子必當因其所同推以度"
    },
    {
      "segId": 403,
      "page": 27,
      "text": "物使彼我之閒各得分願則上下四旁均齊方正而天下平矣。"
    },
    {
      "segId": 404,
      "page": 27,
      "text": "所惡於上母以使下；"
    },
    {
      "segId": 405,
      "page": 27,
      "text": "所惡於下母以事上；"
    },
    {
      "segId": 406,
      "page": 27,
      "text": "所惡於前母以先後；"
    },
    {
      "segId": 407,
      "page": 27,
      "text": "所惡於後母以從前；"
    },
    {
      "segId": 408,
      "page": 27,
      "text": "所惡於右母以交於左；"
    },
    {
      "segId": 409,
      "page": 27,
      "text": "所惡於左母以交於右此之謂絜矩之道。"
    },
    {
      "segId": 410,
      "page": 27,
      "text": "惡先並去聲。"
    },
    {
      "segId": 411,
      "page": 27,
      "text": "此覆解上文絜矩二字之義。"
    },
    {
      "segId": 412,
      "page": 27,
      "text": "如不欲上之無禮於我則必以此度下之心而亦不敢以此無禮使之。"
    },
    {
      "segId": 413,
      "page": 28,
      "text": "不欲下之不忠於我則必以此度上之心而亦不敢以此不忠事之。"
    },
    {
      "segId": 414,
      "page": 28,
      "text": "至於前後左右無不皆然則身之所處上下四旁長短廣狹彼此如一而無不方矣。"
    },
    {
      "segId": 415,
      "page": 28,
      "text": "彼同有是心而興起焉者又豈有一夫之不獲哉？"
    },
    {
      "segId": 416,
      "page": 28,
      "text": "所操者約而所及者廣此平天下之要道也。"
    },
    {
      "segId": 417,
      "page": 28,
      "text": "故章內之意皆自此而推之。"
    },
    {
      "segId": 418,
      "page": 28,
      "text": "詩云樂只君子民之父母。"
    },
    {
      "segId": 419,
      "page": 28,
      "text": "民之所好好之民之所惡惡之此之謂民之父母。"
    },
    {
      "segId": 420,
      "page": 28,
      "text": "樂音洛。"
    },
    {
      "segId": 421,
      "page": 28,
      "text": "只音紙。"
    },
    {
      "segId": 422,
      "page": 28,
      "text": "好惡並去聲。"
    },
    {
      "segId": 423,
      "page": 28,
      "text": "下並同。"
    },
    {
      "segId": 424,
      "page": 28,
      "text": "詩小雅南山有臺之篇。"
    },
    {
      "segId": 425,
      "page": 28,
      "text": "只語助辭。"
    },
    {
      "segId": 426,
      "page": 28,
      "text": "言能絜矩而以民心爲己心則是愛民如子而民愛之如父母矣。"
    },
    {
      "segId": 427,
      "page": 28,
      "text": "詩云節彼南山維石巖巖。"
    },
    {
      "segId": 428,
      "page": 28,
      "text": "赫赫師尹民具爾瞻。"
    },
    {
      "segId": 429,
      "page": 28,
      "text": "有國者不可以不慎辟則爲天節讀爲截辟讀爲僻僇與戮。"
    },
    {
      "segId": 430,
      "page": 29,
      "text": "節讀爲截。"
    },
    {
      "segId": 431,
      "page": 29,
      "text": "辟讀爲僻。"
    },
    {
      "segId": 432,
      "page": 29,
      "text": "僇與戮同。"
    },
    {
      "segId": 433,
      "page": 29,
      "text": "詩小雅節南山之篇。"
    },
    {
      "segId": 434,
      "page": 29,
      "text": "節截然髙大貌。"
    },
    {
      "segId": 435,
      "page": 29,
      "text": "師尹周太師尹氏也。"
    },
    {
      "segId": 436,
      "page": 29,
      "text": "具俱也。"
    },
    {
      "segId": 437,
      "page": 29,
      "text": "辟偏也。"
    },
    {
      "segId": 438,
      "page": 29,
      "text": "言在上者人所瞻仰不可不謹。"
    },
    {
      "segId": 439,
      "page": 29,
      "text": "若不能絜矩而好惡徇於一己之偏則身弑國亡爲天下之大戮矣。"
    },
    {
      "segId": 440,
      "page": 29,
      "text": "詩云殷之未喪師克配上帝。"
    },
    {
      "segId": 441,
      "page": 29,
      "text": "儀監于殷峻命不易。"
    },
    {
      "segId": 442,
      "page": 29,
      "text": "道得衆則得國失衆則失國。"
    },
    {
      "segId": 443,
      "page": 29,
      "text": "喪去聲。"
    },
    {
      "segId": 444,
      "page": 29,
      "text": "儀詩作宜。"
    },
    {
      "segId": 445,
      "page": 29,
      "text": "峻詩作駿。"
    },
    {
      "segId": 446,
      "page": 29,
      "text": "易去聲。"
    },
    {
      "segId": 447,
      "page": 29,
      "text": "詩文王篇。"
    },
    {
      "segId": 448,
      "page": 29,
      "text": "師衆也。"
    },
    {
      "segId": 449,
      "page": 29,
      "text": "配對也。"
    },
    {
      "segId": 450,
      "page": 29,
      "text": "配上帝言其爲天下君而對乎上帝也。"
    },
    {
      "segId": 451,
      "page": 29,
      "text": "監視也。"
    },
    {
      "segId": 452,
      "page": 29,
      "text": "峻大也。"
    },
    {
      "segId": 453,
      "page": 29,
      "text": "不易言難保也。"
    },
    {
      "segId": 454,
      "page": 29,
      "text": "道言也。"
    },
    {
      "segId": 455,
      "page": 29,
      "text": "引詩而言此以結上文兩節之意。"
    },
    {
      "segId": 456,
      "page": 29,
      "text": "有天下者能存此心而不失則所以絜矩而與民同欲者自不能巳矣。"
    },
    {
      "segId": 457,
      "page": 30,
      "text": "是故君子先慎乎德。"
    },
    {
      "segId": 458,
      "page": 30,
      "text": "有德此有人有人此有土有土此有財有財此有用。"
    },
    {
      "segId": 459,
      "page": 30,
      "text": "先謹乎德承上文不可不謹而言。"
    },
    {
      "segId": 460,
      "page": 30,
      "text": "德即所謂明德。"
    },
    {
      "segId": 461,
      "page": 30,
      "text": "有人謂得衆。"
    },
    {
      "segId": 462,
      "page": 30,
      "text": "有土謂得國。"
    },
    {
      "segId": 463,
      "page": 30,
      "text": "有國則不患無財用矣。"
    },
    {
      "segId": 464,
      "page": 30,
      "text": "德者本也；"
    },
    {
      "segId": 465,
      "page": 30,
      "text": "財者末也。"
    },
    {
      "segId": 466,
      "page": 30,
      "text": "本上文而言。"
    },
    {
      "segId": 467,
      "page": 30,
      "text": "外本内末爭民施奪。"
    },
    {
      "segId": 468,
      "page": 30,
      "text": "人君以德爲外以財爲内則是爭鬭其民而施之以刼奪之教也。"
    },
    {
      "segId": 469,
      "page": 30,
      "text": "蓋財者人之所同欲不能絜矩而欲專之則民亦起而爭奪矣。"
    },
    {
      "segId": 470,
      "page": 30,
      "text": "是故財聚則民散財散則民聚。"
    },
    {
      "segId": 471,
      "page": 30,
      "text": "外本内末故財聚爭民施奪故民散。"
    },
    {
      "segId": 472,
      "page": 30,
      "text": "反是則有德而有人矣。"
    },
    {
      "segId": 473,
      "page": 30,
      "text": "是故言悖而出者亦悖而入；"
    },
    {
      "segId": 474,
      "page": 30,
      "text": "貨悖而入者亦悖而出。"
    },
    {
      "segId": 475,
      "page": 31,
      "text": "悖布内反。"
    },
    {
      "segId": 476,
      "page": 31,
      "text": "悖逆也。"
    },
    {
      "segId": 477,
      "page": 31,
      "text": "此以言之出入明貨之出入也。"
    },
    {
      "segId": 478,
      "page": 31,
      "text": "自先謹乎德以下至此又因財貨以明能絜矩與不能者之得失也。"
    },
    {
      "segId": 479,
      "page": 31,
      "text": "康誥曰惟命不于常！"
    },
    {
      "segId": 480,
      "page": 31,
      "text": "道善則得之不善則失之矣。"
    },
    {
      "segId": 481,
      "page": 31,
      "text": "道言也。"
    },
    {
      "segId": 482,
      "page": 31,
      "text": "因上文引文王詩之意而申言之其丁寧反覆之意益深切矣。"
    },
    {
      "segId": 483,
      "page": 31,
      "text": "楚書曰楚國無以爲寶惟善以爲寶。"
    },
    {
      "segId": 484,
      "page": 31,
      "text": "楚書楚語。"
    },
    {
      "segId": 485,
      "page": 31,
      "text": "言不寶金玉而寶善人也。"
    },
    {
      "segId": 486,
      "page": 31,
      "text": "舅犯曰亡人無以爲寶仁親以爲寶。"
    },
    {
      "segId": 487,
      "page": 31,
      "text": "舅犯晉文公舅狐偃字子犯。"
    },
    {
      "segId": 488,
      "page": 31,
      "text": "亡人文公時爲公子出亡在外也。"
    },
    {
      "segId": 489,
      "page": 31,
      "text": "仁愛也。"
    },
    {
      "segId": 490,
      "page": 31,
      "text": "事見檀弓。"
    },
    {
      "segId": 491,
      "page": 31,
      "text": "此兩節又明不外本而内末之意。"
    },
    {
      "segId": 492,
      "page": 32,
      "text": "秦誓曰若有一个臣斷斷兮無他技其心休休焉其如有容焉。"
    },
    {
      "segId": 493,
      "page": 32,
      "text": "人之有技若己有之人之彦聖其心好之不啻若自其口出寔能容之以能保我子孫黎民尚亦有利哉。"
    },
    {
      "segId": 494,
      "page": 32,
      "text": "人之有技媢疾以惡之人之彦聖而違之俾不通寔不能容以不能保我子孫黎民亦曰殆哉。"
    },
    {
      "segId": 495,
      "page": 32,
      "text": "个古賀反書作介。"
    },
    {
      "segId": 496,
      "page": 32,
      "text": "斷丁亂反。"
    },
    {
      "segId": 497,
      "page": 32,
      "text": "媢音冒。"
    },
    {
      "segId": 498,
      "page": 32,
      "text": "秦誓周書。"
    },
    {
      "segId": 499,
      "page": 32,
      "text": "斷斷誠一之貌。"
    },
    {
      "segId": 500,
      "page": 32,
      "text": "彦美士也。"
    },
    {
      "segId": 501,
      "page": 32,
      "text": "聖通明也。"
    },
    {
      "segId": 502,
      "page": 32,
      "text": "尚庶幾也。"
    },
    {
      "segId": 503,
      "page": 32,
      "text": "媢忌也違拂戾也殆危也。"
    },
    {
      "segId": 504,
      "page": 32,
      "text": "違拂戾也。"
    },
    {
      "segId": 505,
      "page": 32,
      "text": "殆危也。"
    },
    {
      "segId": 506,
      "page": 32,
      "text": "唯仁人放流之迸諸四夷不與同中國。"
    },
    {
      "segId": 507,
      "page": 32,
      "text": "此謂唯仁人爲能愛人能惡人。"
    },
    {
      "segId": 508,
      "page": 32,
      "text": "逆讀爲屏古字通用。"
    },
    {
      "segId": 509,
      "page": 32,
      "text": "迸猶逐也。"
    },
    {
      "segId": 510,
      "page": 32,
      "text": "言有此媢疾之人妨賢而病國則仁人必深惡而痛絕之。"
    },
    {
      "segId": 511,
      "page": 32,
      "text": "以其至公無私故能得好惡之正如此也。"
    },
    {
      "segId": 512,
      "page": 33,
      "text": "見賢而不能舉舉而不能先命也；"
    },
    {
      "segId": 513,
      "page": 33,
      "text": "見不善而不能退退而不能遠過也。"
    },
    {
      "segId": 514,
      "page": 33,
      "text": "命鄭氏云當作慢程子云當作怠未詳孰是。"
    },
    {
      "segId": 515,
      "page": 33,
      "text": "遠去聲。"
    },
    {
      "segId": 516,
      "page": 33,
      "text": "若此者知所愛惡矣而未能盡愛惡之道蓋君子而未仁者也。"
    },
    {
      "segId": 517,
      "page": 33,
      "text": "好人之所惡惡人之所好是謂拂人之性菑必逮夫身。"
    },
    {
      "segId": 518,
      "page": 33,
      "text": "蓄古灾字。"
    },
    {
      "segId": 519,
      "page": 33,
      "text": "夫音扶。"
    },
    {
      "segId": 520,
      "page": 33,
      "text": "拂逆也。"
    },
    {
      "segId": 521,
      "page": 33,
      "text": "好善而惡惡人之性也。"
    },
    {
      "segId": 522,
      "page": 33,
      "text": "至於拂人之性則不仁之甚者也。"
    },
    {
      "segId": 523,
      "page": 33,
      "text": "自秦誓至此又皆以申言好惡公私之極以明上文所引南山有臺節南山之意。"
    },
    {
      "segId": 524,
      "page": 33,
      "text": "是故君子有大道必忠信以得之驕泰以"
    },
    {
      "segId": 525,
      "page": 33,
      "text": "失之。"
    },
    {
      "segId": 526,
      "page": 34,
      "text": "君子以位言之。"
    },
    {
      "segId": 527,
      "page": 34,
      "text": "道謂居其位而脩己治人之術。"
    },
    {
      "segId": 528,
      "page": 34,
      "text": "發己自盡爲忠循物無違謂信。"
    },
    {
      "segId": 529,
      "page": 34,
      "text": "驕者矜髙泰者侈肆。"
    },
    {
      "segId": 530,
      "page": 34,
      "text": "此因上所引文王康誥之意而言。"
    },
    {
      "segId": 531,
      "page": 34,
      "text": "章内三言得失而語益加切蓋至此而天理存亡之幾決矣。"
    },
    {
      "segId": 532,
      "page": 34,
      "text": "生財有大道生之者衆食之者寡爲之者疾用之者舒則財恒足矣。"
    },
    {
      "segId": 533,
      "page": 34,
      "text": "恒胡登反。"
    },
    {
      "segId": 534,
      "page": 34,
      "text": "吕氏曰國無遊民則生者衆矣；"
    },
    {
      "segId": 535,
      "page": 34,
      "text": "朝無幸位則食者寡矣；"
    },
    {
      "segId": 536,
      "page": 34,
      "text": "不奪農時則爲之疾矣；"
    },
    {
      "segId": 537,
      "page": 34,
      "text": "量入爲出則用之舒矣。"
    },
    {
      "segId": 538,
      "page": 34,
      "text": "愚按此因有土有財而言以明足國之道在乎務本而節用非必外本内末而後財可聚也。"
    },
    {
      "segId": 539,
      "page": 34,
      "text": "自此以至終篇皆一意也。"
    },
    {
      "segId": 540,
      "page": 34,
      "text": "仁者以財發身不仁者以身發財。"
    },
    {
      "segId": 541,
      "page": 35,
      "text": "發猶起也。"
    },
    {
      "segId": 542,
      "page": 35,
      "text": "仁者散財以得民不仁者亡身以殖貨。"
    },
    {
      "segId": 543,
      "page": 35,
      "text": "未有上好仁而下不好義者也未有好義其事不終者也未有府庫財非其財者也。"
    },
    {
      "segId": 544,
      "page": 35,
      "text": "上好仁以愛其下則下好義以忠其上。"
    },
    {
      "segId": 545,
      "page": 35,
      "text": "所以事必有終而府庫之財無悖出之患也。"
    },
    {
      "segId": 546,
      "page": 35,
      "text": "孟獻子曰畜馬乗不察於雞豚；"
    },
    {
      "segId": 547,
      "page": 35,
      "text": "伐冰之家不畜牛羊；"
    },
    {
      "segId": 548,
      "page": 35,
      "text": "百乗之家不畜聚斂之臣。"
    },
    {
      "segId": 549,
      "page": 35,
      "text": "與其有聚斂之臣寧有盜臣。"
    },
    {
      "segId": 550,
      "page": 35,
      "text": "此謂國不以利爲利以義爲利也。"
    },
    {
      "segId": 551,
      "page": 35,
      "text": "畜許六反。"
    },
    {
      "segId": 552,
      "page": 35,
      "text": "乗斂並去聲。"
    },
    {
      "segId": 553,
      "page": 35,
      "text": "孟獻子魯之賢大夫仲孫蔑也。"
    },
    {
      "segId": 554,
      "page": 35,
      "text": "畜馬乗士初試爲大夫者也。"
    },
    {
      "segId": 555,
      "page": 35,
      "text": "伐冰之家卿大夫以上喪祭用冰者也。"
    },
    {
      "segId": 556,
      "page": 35,
      "text": "百乗之家有采地者也。"
    },
    {
      "segId": 557,
      "page": 36,
      "text": "君子寧亡己之財而不忍傷民之力故寧有盜臣而不畜聚斂之臣。"
    },
    {
      "segId": 558,
      "page": 36,
      "text": "此謂以下釋獻子之言也。"
    },
    {
      "segId": 559,
      "page": 36,
      "text": "長國家而務財用者必自小人矣。"
    },
    {
      "segId": 560,
      "page": 36,
      "text": "彼爲善之小人之使爲國家菑害並至。"
    },
    {
      "segId": 561,
      "page": 36,
      "text": "雖有善者"
    },
    {
      "segId": 562,
      "page": 36,
      "text": "亦無如之何矣！"
    },
    {
      "segId": 563,
      "page": 36,
      "text": "此謂國不以利爲利以義爲利也。"
    },
    {
      "segId": 564,
      "page": 36,
      "text": "長上聲。"
    },
    {
      "segId": 565,
      "page": 36,
      "text": "彼爲善之此句上下疑有闕文誤字。"
    },
    {
      "segId": 566,
      "page": 36,
      "text": "自由也。"
    },
    {
      "segId": 567,
      "page": 36,
      "text": "言由小人導之也。"
    },
    {
      "segId": 568,
      "page": 36,
      "text": "此一節深明以利爲利之害而重言以結之其丁寧之意切矣。"
    },
    {
      "segId": 569,
      "page": 36,
      "text": "右傳之十章。"
    },
    {
      "segId": 570,
      "page": 36,
      "text": "釋治國平天下。"
    },
    {
      "segId": 571,
      "page": 36,
      "text": "此章之義務在與民同好惡而不專其利皆推廣絜矩之意也。"
    },
    {
      "segId": 572,
      "page": 36,
      "text": "能如是則親賢樂利各得其所而天下平矣。"
    },
    {
      "segId": 573,
      "page": 37,
      "text": "凡傳十章前四章統論綱領指趣後六章細論條目功夫。"
    },
    {
      "segId": 574,
      "page": 37,
      "text": "其第五章乃明善之要第六章乃誠身之本在初學尤爲當務之急讀者不可以其近而忽之也。"
    }
  ]
}